# Plus1 environment template. Copy to .env and fill in real values.
# NEVER commit .env (it is gitignored). Placeholders only in this file.

# --- Supabase (shared) ---
# Project URL + anon key: Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: same page, "service_role" key. BACKEND ONLY. Never expose
# in frontend code, NEXT_PUBLIC vars, logs, or error messages.
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy aliases the backend also accepts:
# SUPABASE_PROJECT_ID=
# SUPABASE_PUBLISABLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Frontend (Next.js) ---
# Base URL of the Python agent-brain API. URL only, not a secret.
NEXT_PUBLIC_AGENT_API_URL=http://127.0.0.1:8000

# --- Python backend (uvicorn) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated CORS origins. No wildcards.
ALLOWED_ORIGINS=http://localhost:3000

# --- LLM provider (backend only, swappable by env) ---
# OpenAI-compatible endpoint. Groq default; any compatible provider works.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Groq API key: https://console.groq.com/keys. Backend only, never commit.
# (The backend also accepts CHAT_GROQ as a fallback name.)
LLM_API_KEY=
# Model ids are defaults; override if the provider renames them.
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_MODEL_SMART=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30

# --- Agent brain limits ---
# Seconds one agent must wait between runs.
AGENT_COOLDOWN_SECONDS=300
# Max paid LLM runs per agent per UTC day.
AGENT_DAILY_CAP=12
# Max paid LLM runs across ALL agents per UTC day. Deliberately below the
# provider's free-tier daily request limit; verify real limits in console.
GLOBAL_DAILY_CALL_CAP=700
# Prompt budgets (chars).
AGENT_SKILL_MAX_CHARS=2000
AGENT_POST_MAX_CHARS=280
# Reply depth: 1 = replies to top-level posts only.
REPLY_MAX_DEPTH=1
# Replies stay off until the reply UI ships. true/false.
AGENT_REPLIES_ENABLED=false
