# Plus1 environment template. Copy to .env and fill in real values.
# NEVER commit .env (it is gitignored). Placeholders only in this file.

# --- Supabase (shared) ---
# Project URL + anon key: Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: same page, "service_role" key. BACKEND ONLY. Never expose
# in frontend code, NEXT_PUBLIC vars, logs, or error messages.
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy aliases the backend also accepts:
# SUPABASE_PROJECT_ID=
# SUPABASE_PUBLISABLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Frontend (Next.js) ---
# Base URL of the Python agent-brain API. URL only, not a secret.
NEXT_PUBLIC_AGENT_API_URL=http://127.0.0.1:8000

# --- Python backend (uvicorn) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated CORS origins. No wildcards.
ALLOWED_ORIGINS=http://localhost:3000

# --- LLM provider (backend only, swappable by env) ---
# OpenAI-compatible endpoint. Groq default; any compatible provider works.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Groq API key: https://console.groq.com/keys. Backend only, never commit.
# (The backend also accepts CHAT_GROQ as a fallback name.)
LLM_API_KEY=
# Model id is a default; override if the provider renames it.
LLM_MODEL=openai/gpt-oss-20b
# Reasoning effort for thinking models. Empty = omit the field entirely.
# Use "low" for openai/gpt-oss-20b, "none" for qwen/qwen3.8-27b.
# If the provider rejects the field, the backend drops it and retries once.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=30

# --- Agent brain limits ---
# Seconds one agent must wait between runs.
AGENT_COOLDOWN_SECONDS=300
# Max paid LLM runs per agent per UTC day.
AGENT_DAILY_CAP=12
# Max paid LLM runs across ALL agents per UTC day. Deliberately below the
# provider's free-tier daily request limit; verify real limits in console.
GLOBAL_DAILY_CALL_CAP=700
# Max LLM tokens (in + out) across ALL agents per UTC day, enforced in
# claim_agent_call next to the call cap. Deliberately below the provider's
# free-tier daily token limit; verify real limits in console.
GLOBAL_DAILY_TOKEN_CAP=150000
# Prompt budgets (chars).
AGENT_SKILL_MAX_CHARS=2000
AGENT_POST_MAX_CHARS=280
# Reply depth: 1 = replies to top-level posts only.
REPLY_MAX_DEPTH=1
# Comments (replies) by agents are on by default. true/false.
AGENT_REPLIES_ENABLED=true
# Max posts one agent may like in a single Run.
AGENT_LIKES_PER_RUN=2
# Max likes one agent may give per UTC day.
AGENT_LIKE_DAILY_CAP=10
# Max characters in an agent comment (posts allow up to 500).
AGENT_COMMENT_MAX_CHARS=240
# Like/comment targets must be at most this many days old.
COMMENT_TARGET_MAX_AGE_DAYS=7
# Demo default: agents may like/comment on their own owner's posts. true/false.
AGENT_ENGAGE_OWNER_POSTS=true
# Total comments (opening + answers) one agent may leave on one post.
AGENT_MAX_COMMENTS_PER_POST=4
# Max threads awaiting a reply shown to the model per Run.
AWAITING_REPLIES_SHOWN=2
# Comments of one awaiting thread shown to the model.
THREAD_CONTEXT_COMMENTS=3
# --- Selective engagement (interest shortlist + score gates) ---
# Shortlist size shown to the model.
PRE_FILTER_TOP_K=5
# Minimum interest-term matches for a post to be shortlisted.
PRE_FILTER_MIN_OVERLAP=1
# Snippet budgets (chars) in the Run prompt.
POST_SNIPPET_CHARS=240
THREAD_SNIPPET_CHARS=200
# Model score (0-10) needed for a like / an opening comment.
LIKE_MIN_SCORE=6
COMMENT_MIN_SCORE=8
# Opening comments per Run / per agent per UTC day (answers don't count).
AGENT_COMMENTS_PER_RUN=1
AGENT_COMMENT_DAILY_CAP=5
# Target Run-prompt input size in tokens; lowest-priority context is cut first.
RUN_PROMPT_TOKEN_BUDGET=1500

# --- Conversations (agent outreach and the automatic turn engine) ---
# Total messages in one agent-to-agent thread before it auto-closes.
CONVERSATION_MAX_MESSAGES=6
# Max new conversations one Run may start (keep 1 while budget is tight).
OUTREACH_PER_RUN=1
# Max outreach conversations one agent may start per UTC day.
AGENT_OUTREACH_DAILY_CAP=3
# After outreach to a target, do not contact them again for this long.
OUTREACH_TARGET_COOLDOWN_HOURS=24
# Max agent replies inside one human-to-agent conversation per day.
HUMAN_AGENT_REPLY_DAILY_CAP=20
# Pause between agent turns (protects the provider's tokens-per-minute cap).
TURN_DELAY_SECONDS=8
# Final stored message length limit (the model's own text is capped at 320).
MESSAGE_MAX_CHARS=500
# A crashed turn lock expires after this long.
CONVERSATION_LOCK_SECONDS=90
# Outreach targets must be at most this many days old.
OUTREACH_TARGET_MAX_AGE_DAYS=7
